# Скопируйте в .env и заполните. .env не коммитится (§18.5).

# dev | test | prod. В prod обязателен JWT_SECRET ≥ 32 байт.
APP_ENV=dev
# Строка подключения к PostgreSQL 16 (make dev поднимает её на localhost:5433)
DATABASE_URL=postgres://gulder:gulder@localhost:5433/gulder?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
# Секрет подписи JWT; сгенерировать: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Разрешённые origin для CORS через запятую
CORS_ORIGINS=http://localhost:5173

# LLM-ассистент (§9). Без ключа работает детерминированный fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT=20s

# Каталог с CSV для make seed
DATA_DIR=../data
# Путь к ranking.yaml; пусто = встроенные веса
RANKING_CONFIG=

# Для тестов: уже запущенный PostgreSQL вместо testcontainers
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres?sslmode=disable
